{
  "name": "@kie-ai-tool/openai-server",
  "version": "0.1.0",
  "description": "OpenAI-compatible HTTP transport for selected Kie.ai image and video models.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "kie-ai-openai-server": "dist/bin.js"
  },
  "scripts": {
    "build": "npm run build -w @kie-ai-tool/core && tsc -p tsconfig.json --emitDeclarationOnly && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "prepack": "npm run test"
  },
  "keywords": [
    "kie.ai",
    "openai",
    "image-generation",
    "video-generation"
  ],
  "author": "Andre Tansil (https://github.com/tansilandre)",
  "contributors": [
    "andrewlwn77 (https://github.com/andrewlwn77)",
    "felores (https://github.com/felores)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tansilandre/kie-ai-tool-mcp-skills-agent.git",
    "directory": "packages/openai"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@types/express": "^4.17.21",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@kie-ai-tool/core": "*",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/tansilandre/kie-ai-tool-mcp-skills-agent#readme",
  "bugs": {
    "url": "https://github.com/tansilandre/kie-ai-tool-mcp-skills-agent/issues"
  }
}
