{
  "name": "@kie-ai-tool/cli",
  "version": "0.1.0",
  "description": "Standalone CLI for Kie.ai APIs: generate images, video, music and speech from the terminal. Same models as the Kie.ai MCP server, no MCP client required.",
  "main": "dist/index.js",
  "bin": {
    "kie": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "bundle": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build -w @kie-ai-tool/core && npm run bundle"
  },
  "keywords": [
    "kie.ai",
    "ai",
    "cli",
    "image-generation",
    "video-generation",
    "music-generation",
    "text-to-speech",
    "nano-banana",
    "veo3"
  ],
  "author": "Andre Tansil (https://github.com/tansilandre)",
  "contributors": [
    "andrewlwn77 (https://github.com/andrewlwn77)",
    "felores (https://github.com/felores)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tansilandre/kie-ai-tool-mcp-skills-agent.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/tansilandre/kie-ai-tool-mcp-skills-agent#readme",
  "bugs": {
    "url": "https://github.com/tansilandre/kie-ai-tool-mcp-skills-agent/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "yargs": "^17.7.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kie-ai-tool/core": "*",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/yargs": "^17.0.33",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ]
}
